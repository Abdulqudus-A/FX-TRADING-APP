# Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=fx_trading

# JWT
JWT_SECRET=change-this-to-a-random-secret-min-32-chars
JWT_EXPIRES_IN=15m

# Gmail SMTP (use a Google App Password, not your account password)
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# FX Rate API (https://www.exchangerate-api.com - free tier)
FX_API_KEY=your-exchangerate-api-key
FX_API_BASE_URL=https://v6.exchangerate-api.com/v6
FX_CACHE_TTL_SECONDS=300

# Supported currency pairs (comma-separated, NGN-anchored)
SUPPORTED_CURRENCIES=USD,EUR,GBP,CAD,JPY

# Trade config
TRADE_SPREAD_PERCENT=0.005
TRADE_FEE_FLAT=0

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate limiting
THROTTLE_TTL_SHORT=1000
THROTTLE_LIMIT_SHORT=5
THROTTLE_TTL_MEDIUM=60000
THROTTLE_LIMIT_MEDIUM=100

# Admin Seed (used by: npm run seed:admin)
SEED_ADMIN_EMAIL=admin@fxtrading.dev
SEED_ADMIN_PASSWORD=Admin@12345!
